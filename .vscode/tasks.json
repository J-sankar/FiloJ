{
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
    },
    "tasks": [
        {
            "label": "Gateway",
            "type": "shell",
            "command": "uv run uvicorn gateway.main:app --reload"
        },
        {
            "label": "Service: Auth",
            "type": "shell",
            "command": "uv run uvicorn auth_service.main:app --reload --port 8001"
        },
        {
            "label": "Service: File API",
            "type": "shell",
            "command": "uv run uvicorn api.main:app --reload --port 8002"
        },
        {
            "label": "Worker: Security Scanner",
            "type": "shell",
            "command": "uv run python -m security_scanner.worker"
        },
        {
            "label": "Worker: Image Processor",
            "type": "shell",
            "command": "uv run python -m image_processor.worker"
        },
        {
            "label": "Docker Compose",
            "type": "shell",
            "command": "docker compose up"
        },
        {
            "label": "Full Start",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Gateway",
                "Service: Auth",
                "Service: File API",
                "Worker: Security Scanner",
                "Worker: Image Processor",
                "Docker Compose"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "System: Kill All",
            "type": "shell",
            "command": "make stop && make reset-redis",
            "problemMatcher": []
        }
    ]
}